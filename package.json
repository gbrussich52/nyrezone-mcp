{
  "name": "nyrezone-mcp",
  "version": "0.2.0",
  "description": "NYRezone MCP - recorded NYC parcel and FAR fields plus NYRezone HTML district summaries",
  "type": "module",
  "bin": { "nyrezone-mcp": "./dist/cli.js" },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": ["dist", "!dist/test", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "tsc -p tsconfig.json --watch",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/gbrussich52/nyrezone-mcp.git" },
  "homepage": "https://github.com/gbrussich52/nyrezone-mcp#readme",
  "bugs": { "url": "https://github.com/gbrussich52/nyrezone-mcp/issues" },
  "keywords": ["mcp", "model-context-protocol", "zoning", "nyc", "real-estate", "far", "mappluto", "ai-agent", "claude"],
  "mcpName": "io.github.gbrussich52/nyrezone-mcp"
}
